# Copie para .env e preencha. O .env nunca vai para o git.

# --- Instagram: Graph API (conta profissional própria + página do Facebook + app da Meta)
META_ACCESS_TOKEN=
META_IG_USER_ID=
# Conferir a versão atual no painel da Meta
META_GRAPH_VERSION=v27.0

# --- YouTube Data API v3
YOUTUBE_API_KEY=

# --- Texto: Groq (cliente herdado do Case Suno)
LLM_MODE=simulated
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Gerador e juiz precisam ser modelos diferentes
GROQ_GENERATION_MODEL_ID=openai/gpt-oss-120b
GROQ_JUDGE_MODEL_ID=qwen/qwen3.8-27b
GROQ_GENERATION_TEMPERATURE=0.3
GROQ_GENERATION_REASONING_EFFORT=low
GROQ_JUDGE_TEMPERATURE=0
GROQ_JUDGE_REASONING_EFFORT=
GROQ_MAX_COMPLETION_TOKENS=0
GROQ_MAX_CALLS_PER_RUN=60
GROQ_ESTIMATED_OUTPUT_TOKENS=1200
GROQ_MAX_RETRIES_429=6
GROQ_MAX_RATE_LIMIT_WAIT=65
GROQ_OTPM=0
# Preencher com os limites reais da conta, vistos no console
GROQ_TPM=8000

# --- Vídeo: Gemini (camada 2)
GEMINI_API_KEY=
# Opcional; padrão gemini-3.5-flash, com 3.7 e 3.8 de reserva quando um estiver sobrecarregado
GEMINI_MODEL_ID=

# --- Cache e app
CACHE_DIR=.cache/stone
APP_TIMEZONE=America/Sao_Paulo
# Opcional: protege as ações que gastam cota ou mudam dados (gerar, aprovar). Vazio = sem senha (uso local)
BOAPAUTA_TOKEN=
# Opcionais: banco do app (peças, playbooks) e pasta da coleta usada (padrão: a mais recente em data/raw)
BOAPAUTA_DB=
BOAPAUTA_COLETA=

# Opcional: Insights (alcance, salvamentos, compartilhamentos) das contas da Stone. Token de quem administra a conta,
# com a permissão instagram_manage_insights; pedir à equipe da Stone. Sem eles, a análise usa curtidas e comentários.
STONE_IG_TOKEN_STONE=
STONE_IG_TOKEN_IMPULSOSTONE=
